  "label": "create-order_lines",
  "sql": "CREATE TABLE lakekeeper.silver_20261015005452.order_lines WITH (format='PARQUET',format_version=2) AS SELECT trim(c.name) AS name,c.custkey,o.orderkey,\n       o.orderdate,CAST(o.totalprice AS DECIMAL(18,2)) AS totalprice,l.linenumber,\n       CAST(l.quantity AS DECIMAL(18,2)) AS quantity\n       FROM lakekeeper.bronze_20261015005452.customer c\n       JOIN lakekeeper.bronze_20261015005452.orders o ON c.custkey=o.custkey\n       JOIN lakekeeper.bronze_20261015005452.lineitem l ON l.orderkey=o.orderkey\n       JOIN lakekeeper.silver_20261015005452.large_orders big ON big.orderkey=o.orderkey",
